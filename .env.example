# Backend (root .env — Vercel: Project Settings → Environment Variables)
# Required for GMC daily limits + saved reports on serverless:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for auth token validation on API (optional if login disabled):
SUPABASE_ANON_KEY=

# Frontend (frontend/.env — Vercel build env or local)
# Required for login/register session persistence:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
#
# Supabase Dashboard → Authentication → Providers → Email: enable Email provider.
# Optional: disable "Confirm email" for local dev instant login after register.

# Optional
# REPORT_STORAGE_FALLBACK=true
# REPORT_STORAGE_DIR=./data/reports
